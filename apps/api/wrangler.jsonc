{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "girls-boys-paradise",
  "main": "src/index.ts",
  "compatibility_date": "2025-04-17",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gbp-community",
      "database_id": "82e73016-a51c-4540-9ac1-f0fb6068879f",
      "migrations_dir": "../../packages/database/migrations"
    }
  ],
  "vars": { "DASHBOARD_ORIGIN": "http://localhost:5173" }
}
